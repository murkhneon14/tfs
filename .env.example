# ==============================================================================
# The Family Store - Environment Variables Template
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (PostgreSQL Database & Storage Only)
# Note: Used strictly for database queries and image storage.
# Supabase Auth is NOT used; custom authentication is implemented.
# ------------------------------------------------------------------------------
# Your Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (secret server-side key with administrative access)
# NEVER expose this key to client-side code or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ------------------------------------------------------------------------------
# 2. Application & Session Security
# ------------------------------------------------------------------------------
# Base URL of the application (used for OAuth redirects and canonical links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cryptographically random string (min 32 bytes) used for session hashing / cookie signing
# Generate with: openssl rand -base64 32 (or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your-random-session-secret-at-least-32-chars

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 (OpenID Connect Flow)
# Created in Google Cloud Console -> APIs & Services -> Credentials
# ------------------------------------------------------------------------------
# OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Authorized redirect URI configured in Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
